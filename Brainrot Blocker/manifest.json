{
    "manifest_version": 3,
    "name": "Brainrot Blocker",
    "version": "1.0",
    "description": "Helps you focus while studying by blocking brainrot content.",
    "permissions": [
        "storage",
        "tabs",
        "alarms",
        "notifications"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content.js"
            ],
            "css": [
                "styles/styles.css"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "popup/locales/*.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "icons": {
        "128": "icons/icon128.png"
    }
}